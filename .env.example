# AI Video-Clipping Website — OpenShorts + Groq + Backblaze B2 (Variant B)
#
# Copy to openshorts/.env (or export in your shell / Secret Manager).
# PLACEHOLDERS ONLY — never commit a real key. Real keys live in the
# environment (local .env, git-ignored) or in Google Secret Manager on
# Cloud Run. See DEPLOY.md.

# --- AI: Groq (moment picking / virality scoring / titles) -----------------
# Groq is OpenAI-compatible: https://api.groq.com/openai/v1
# DO NOT use llama-3.3-70b-versatile — Groq retired Llama 3.x for free /
# developer tiers in Aug 2026 (Enterprise only now).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# LLM_MODEL=openai/gpt-oss-20b   # faster/cheaper fallback
LLM_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
# LLM_SCORE_BATCH=3               # keep 3 on Groq free tier (8,000 TPM cap)
LLM_TIMEOUT=600
# Do NOT set LLM_PROVIDER=gemini — that forces Gemini even with a base URL.
# Without a Gemini key, layout picking / silent videos fall back to plain
# face-track crop (see README.md "Known limits").

# --- Transcription: local faster-whisper (default, recommended) -------------
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# Groq Whisper is NOT wired in: it returns no SRT/VTT and has a 25 MB file
# cap on the free tier, so transcription stays local.

# --- Storage: Backblaze B2 (S3-compatible file storage) --------------------
# B2 is FILE storage, not a database. Job metadata lives in SQLite locally
# (OpenShorts default) and in Neon/Supabase Postgres in Variant B.
# Create a private bucket + an application key restricted to that bucket.
AWS_ACCESS_KEY_ID=PASTE_YOUR_B2_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=PASTE_YOUR_B2_APPLICATION_KEY_HERE
AWS_REGION=us-west-004
AWS_S3_BUCKET=your-b2-bucket-name
AWS_S3_PUBLIC_BUCKET=your-b2-public-bucket-name
# This is the patch in openshorts/s3_uploader.py: without it OpenShorts
# talks to AWS only. With it, boto3 points at B2.
S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com

# --- Jobs ------------------------------------------------------------------
MAX_CONCURRENT_JOBS=1           # Groq free tier 429s above ~1 video/min
JOB_RETENTION_SECONDS=604800    # 7 days (upstream default is 24 h)

# --- Metadata DB (Variant B only) ------------------------------------------
# Local run: leave unset (OpenShorts uses SQLite). Variant B: Neon free.
# DATABASE_URL=postgresql://user:password@host:5432/clips
